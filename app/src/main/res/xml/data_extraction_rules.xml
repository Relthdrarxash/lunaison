<?xml version="1.0" encoding="utf-8"?>
<!--
    Règles de sauvegarde Android 12 et plus. LunaisonBackupAgent applique en plus le choix de la personne :
    sauvegarde dans le compte Google désactivée par défaut, et jamais sans chiffrement de bout en bout.
    Le transfert direct vers un nouveau téléphone (câble ou sans fil) reste toujours permis.
    Avant Android 12, android:fullBackupContent="false" coupe toute sauvegarde.
    allowBackup reste actif : avec false, le transfert direct peut être bloqué selon les constructeurs.
-->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <include domain="database" />
        <include domain="sharedpref" />
        <include domain="file" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" />
        <include domain="sharedpref" />
        <include domain="file" />
    </device-transfer>
</data-extraction-rules>
